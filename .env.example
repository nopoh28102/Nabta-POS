# انسخ هذا الملف إلى .env على جهاز الخادم فقط، ولا تضع الملف الناتج في Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=7443
DISCOVERY_PORT=47620
# الوضع الافتراضي: PostgreSQL مضمّن داخل عملية الخادم، ولا يحتاج تثبيت قاعدة بيانات.
DATABASE_MODE=embedded
DATABASE_DIR=C:\ProgramData\Nabta\data\pglite
# اترك DATABASE_URL فارغاً في الوضع المضمّن. استخدمه فقط مع DATABASE_MODE=postgres.
# DATABASE_URL=postgresql://nabta_app:CHANGE_ME@127.0.0.1:5432/nabta
SETUP_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
SESSION_TTL_MINUTES=480
TLS_CERT_PATH=C:\ProgramData\Nabta\certs\server.crt
TLS_KEY_PATH=C:\ProgramData\Nabta\certs\server.key
# في وضع المثبت المضمن يستخدم الخادم ملف PFX الذي ينشئه المثبت تلقائياً:
# TLS_PFX_PATH=C:\ProgramData\Nabta\server\server.pfx
# TLS_PFX_PASSWORD=ضع_كلمة_مرور_خارج_المستودع
# TLS_FINGERPRINT=بصمة_الشهادة_بدون_فواصل
BACKUP_DIR=D:\NabtaBackups
# مطلوب فقط عند DATABASE_MODE=postgres.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
BACKUP_RETENTION_DAYS=30
LOG_LEVEL=info
