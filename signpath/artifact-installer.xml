<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: one NSIS installer in a GitHub Actions ZIP.
     Validate the actual Windows VERSIONINFO values with SignPath before enabling. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Nabta-POS-*-x64.exe" product-name="نبتة" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
