<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: upload-artifact produces a ZIP containing the app EXE.
     Check the product/file versions against a sample from electron-builder before applying. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="نبتة.exe" product-name="نبتة" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
